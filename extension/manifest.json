{
  "manifest_version": 3,
  "name": "کویرتایر — خرید سریع",
  "version": "1.2.0",
  "description": "پایش سبک موجودی کویرتایر بدون رفرش مکرر، انتخاب محصول، افزودن به سبد و باز کردن سریع درگاه پرداخت.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "کویرتایر — خرید سریع (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "notifications",
    "tabs",
    "contextMenus"
  ],
  "host_permissions": [
    "*://kavirtire.ir/*",
    "*://*.kavirtire.ir/*"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://kavirtire.ir/esale/*",
        "*://*.kavirtire.ir/esale/*"
      ],
      "js": [
        "src/content/net.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://kavirtire.ir/esale/*",
        "*://*.kavirtire.ir/esale/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "*://kavirtire.ir/esale/*",
        "*://*.kavirtire.ir/esale/*"
      ],
      "js": [
        "src/shared/defaults.js",
        "src/content/core.js",
        "src/content/trace.js",
        "src/content/guard.js",
        "src/content/site.js",
        "src/content/engine.js",
        "src/content/qty.js",
        "src/content/payment.js",
        "src/content/panel.js",
        "src/content/trace-viewer.js",
        "src/content/main.js"
      ],
      "run_at": "document_end",
      "world": "MAIN"
    }
  ],
  "commands": {
    "toggle-monitoring": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "شروع/توقف پایش موجودی"
    },
    "toggle-panel": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "نمایش/پنهان کردن پنل خرید سریع"
    }
  }
}
